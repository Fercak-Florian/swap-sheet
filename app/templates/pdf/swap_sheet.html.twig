{% extends 'base.html.twig' %}

{% block title %}SwapSheet Application{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/pdf.css') }}">
{% endblock %}

{% block body %}
    <style>
        /*.example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }*/
        /*.example-wrapper code { background: #F5F5F5; padding: 2px 6px; }*/
    </style>

    <div>
        <header>
            Fiche de suivi 26E
        </header>
        <div class="sub-header">
            <div class="infos">
                <div>Taille Disque : </div>
                <div>Modèle : </div>
            </div>
            <div class="infos">
                <div>BIOS : </div>
                <div>Date Master : </div>
            </div>
        </div>

        <div class="item">
            <div class="inside">N° de Tatouage : {{ swapSheet.newComputerTattoo }}</div>
        </div>

        <div class="item">
            <div class="inside">Nom du TSP : {{ swapSheet.tspName }}</div>
        </div>

        <div class="user">
            <div class="inside">Utilisateur : {{ swapSheet.userName }}</div>
            <div class="inside">Code Ident : {{ swapSheet.cuid }}</div>
        </div>

        <div class="item">
            <div class="inside">N° DMI / INC / MYI : {{ swapSheet.incidentNumber }} </div>
        </div>

        <div class="item">
            <div class="inside">Date de remise : </div>
        </div>

        <label for="story">Observations&nbsp;:</label>
        <textarea id="story" rows="10">
        </textarea>

        <footer>
            <div>A mettre dans le PC HS</div>
            <div>Ancien pc : {{ swapSheet.oldComputerTattoo }} </div>
            <div>Modèle : {{ swapSheet.oldComputerModel }}</div>
            <div>Symptôme : {{ swapSheet.symptom }} </div>
        </footer>
    </div>

    </div>
{% endblock %}
