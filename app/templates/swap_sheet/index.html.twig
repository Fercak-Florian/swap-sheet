{% extends 'base.html.twig' %}

{% block title %}SwapSheet Application{% endblock %}

{% block body %}
    <style>
        .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
        .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
    </style>

    <div class="example-wrapper">
        <h1 class="text-primary fw-bold">Hello {{ controller_name }}</h1>
        {{ form_start(form, {'attr': {
            'data-turbo': 'false',
            'novalidate': 'novalidate'
        }}) }}
            {{ form_errors(form) }}
                {{ form_row(form.newComputerTattoo, {'label': 'Tatouage du nouvel ordinateur : '}) }}
                {{ form_row(form.tspName, {'label': 'Nom du TSP : '}) }}
                {{ form_row(form.userName, {'label': 'Utilisateur : '}) }}
                {{ form_row(form.cuid, {'label': 'Code Ident : '}) }}
                {{ form_row(form.incidentNumber, {'label': 'Numero d"incident : '}) }}
                {{ form_row(form.oldComputerTattoo, {'label': 'Tatouage de l"ancien ordinateur  : '}) }}
            {{ form_rest(form) }}
        {{ form_end(form) }}
    </div>
{% endblock %}
